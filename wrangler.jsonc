{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kipuka-dev",
  "compatibility_date": "2026-10-02",
  "assets": { "directory": "./deploy", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kipuka.dev", "custom_domain": true }]
}
